#!/usr/bin/env node
import { resumeRender, renderShot, stillsShot, verifyShot, inspectShot, lintShot, doctor, statusJob, cancelJob } from '../src/index.mjs';
import { benchmark } from '../src/benchmark.mjs';
import { serve } from '../src/serve.mjs';
import { setup } from '../src/setup.mjs';
import { postArgs, scaleArgs } from '../src/post.mjs';
import { createEvents, version } from '../src/events.mjs';
import { asError, invalidOption } from '../src/errors.mjs';
import { waitJob } from '../src/jobs.mjs';
import { claimExecutor, resultExitCode } from '../src/hosted.mjs';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2), json = args.includes('--json');
const common = [...postArgs, ...scaleArgs, 'static-reuse', 'no-static-reuse', 'alpha', 'fps', 'raster', 'root', 'job-dir', 'no-lint', 'overwrite', 'no-hosted', 'job-dir-exact', 'hosted-executor'];
const allowed = {
  inspect: ['root', 'fps', 'no-lint'], serve: ['root', 'port'],
  render: [...common, 'format', 'draft', 'out', 'from', 'to', 'workers', 'encoder', 'max-bitrate', 'audio', 'audio-offset', 'ffmpeg'],
  stills: [...common, 'draft', 'out', 'at', 'every'], verify: [...common, 'draft', 'out', 'at', 'workers'],
  benchmark: ['raster', 'max-workers'], config: [], skill: ['host', 'force', 'expect'],
  lint: ['root'], doctor: ['ffmpeg', 'raster'], status: ['job-dir'], cancel: ['job-dir', 'wait'],
  wait: ['job-dir', 'timeout'],
  resume: ['job-dir', 'workers', 'no-hosted', 'job-dir-exact', 'hosted-executor'],
};
// Internal flags used by the desktop app to start hosted executors; not listed in help.
const internal = ['job-dir-exact', 'hosted-executor'];
const listed = flags => flags.filter(f => !internal.includes(f));
let reported = false;
const onEvent = event => {
  if (event.type === 'result') reported = true;
  if (json) process.stdout.write(JSON.stringify(event) + '\n');
  else if (event.type === 'result') {
    if (event.ok) console.log(JSON.stringify(event.data, null, 2));
    else console.error(event.code + ': ' + event.message + (event.hint ? '\n' + event.hint : ''));
  } else if (event.type === 'listening') console.log(event.url);
  else if (['progress', 'warning', 'finding'].includes(event.type)) console.error(JSON.stringify(event));
};
let command = args[0] ?? 'doctor';
try {
  const executor = ['render', 'stills', 'verify', 'resume'].includes(command) && args.includes('--hosted-executor');
  const exactIndex = args.indexOf('--job-dir-exact');
  const lostClaim = executor && (exactIndex < 0 || !args[exactIndex + 1]
    || !await claimExecutor(args[exactIndex + 1], command));
  const onBytes = bytes => new Promise((resolve, reject) => process.stdout.write(bytes, error => error ? reject(error) : resolve()));
  if (lostClaim) { process.exitCode = 0; }
  else if (args.length === 1 && args[0] === '--version') console.log(version);
  else if (args.length === 0 || args[0] === '--help') {
    console.log('Usage: multiplane <render|stills|verify|inspect|lint> <shot.html> [--json] [--option value]\n'
      + '       multiplane serve [--root directory] [--port number] [--json]\n'
      + '       multiplane <status|cancel> <jobId|jobDir> [--json] [--wait seconds]\n'
      + '       multiplane resume <jobId|jobDir> [--json] [--workers n] [--job-dir directory] [--no-hosted]\n'
      + '       multiplane wait <jobId|jobDir> [--json] [--timeout seconds]\n'
      + '       multiplane benchmark [--json] [--raster gpu|software] [--max-workers n]\n'
      + '       multiplane doctor [--json] [--ffmpeg path]\n'
      + '       multiplane config <get [key]|set key value|unset key> [--json]\n'
      + '       multiplane skill <status|install|remove> [--host claude|codex|all] [--force] [--expect signature] [--json]\n'
      + Object.entries(allowed).map(([name, flags]) => name + ': ' + listed(flags).map(f => '--' + f).join(' ')).join('\n'));
  } else if (['config', 'skill'].includes(command)) {
    if (args.includes('--help')) console.log(command === 'config'
      ? 'Usage: multiplane config <get [key]|set key value|unset key> [--json]\nKeys: ffmpeg jobsDir raster encoder workers hosted'
      : 'Usage: multiplane skill <status|install|remove> [--host claude|codex|all] [--force] [--expect signature] [--json]\nInstall and remove require --host.');
    else await setup(command, args.slice(1), onEvent);
  } else {
    if (!allowed[command]) throw invalidOption('command', 'Unknown command: ' + command);
    if (args.includes('--help')) {
      console.log('Usage: multiplane ' + command + (['doctor', 'serve', 'benchmark'].includes(command) ? '' : ['status', 'cancel', 'wait', 'resume'].includes(command) ? ' <jobId|jobDir>' : ' <shot.html>') + ' [options]\nOptions: --json --help ' + listed(allowed[command]).map(f => '--' + f + (['static-reuse', 'no-static-reuse', 'overwrite', 'no-lint', 'no-post', 'alpha', 'draft', 'no-hosted', 'hosted-executor'].includes(f) ? '' : ' <value>')).join(' '));
    } else {
      const needsTarget = !['doctor', 'serve', 'benchmark'].includes(command);
      const target = needsTarget ? args[1] : undefined;
      if (needsTarget && (!target || target.startsWith('--'))) throw invalidOption('target', 'Provide a shot or job path.');
      const flags = args.slice(needsTarget ? 2 : 1), options = {};
      for (let i = 0; i < flags.length;) {
        const flag = flags[i], key = flag.replace(/^--/, '');
        if (!flag.startsWith('--') || !(allowed[command].includes(key) || key === 'json') || key in options) throw invalidOption(flag, 'Invalid or duplicate option: ' + flag);
        if (['static-reuse', 'no-static-reuse', 'json', 'alpha', 'no-post', 'overwrite', 'no-lint', 'draft', 'no-hosted', 'hosted-executor'].includes(key)) { options[key] = true; i++; }
        else {
          if (flags[i + 1] === undefined || flags[i + 1].startsWith('--')) throw invalidOption(flag, 'Missing option value: ' + flag);
          options[key] = flags[i + 1]; i += 2;
        }
      }
      delete options.json;
      if (options['job-dir-exact'] && !executor) throw invalidOption('--job-dir-exact', '--job-dir-exact requires --hosted-executor.');
      options.onEvent = executor ? undefined : onEvent;
      if (['render', 'stills', 'verify', 'resume'].includes(command) && !executor) options._hostedCLI = {
        args: args.slice(1).filter(arg => arg !== '--json'), bin: fileURLToPath(import.meta.url), onBytes,
      };
      if (command === 'wait') {
        const result = await waitJob(target, { ...options, onEvent: json ? undefined : onEvent, onBytes: json ? onBytes : undefined });
        reported = true; process.exitCode = resultExitCode(result);
      } else {
        const action = { resume: resumeRender, render: renderShot, stills: stillsShot, verify: verifyShot, inspect: inspectShot, serve, lint: lintShot, doctor, benchmark, status: statusJob, cancel: cancelJob }[command];
        const result = needsTarget ? await action(target, options) : await action(options);
        if (result?.ok !== undefined) { reported = true; process.exitCode = resultExitCode(result); }
      }
    }
  }
} catch (failure) {
  const error = asError(failure);
  if (!reported) createEvents(command, null, { onEvent }).finish({}, error);
  process.exitCode = error.exitCode;
}
