{
  "name": "multiplane",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./three": "./src/three/index.js",
    "./runtime/*": "./src/runtime/*"
  },
  "bin": {
    "multiplane": "bin/multiplane"
  },
  "files": [
    "src/",
    "bin/",
    "examples/",
    "skills/",
    "tools/install-browser.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node tools/install-browser.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "export:public": "node tools/export-public.mjs",
    "release:check": "node tools/release-check.mjs",
    "bench": "node tools/bench/run.mjs"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "parse5": "7.3.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "three": "0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.180.0"
  },
  "overrides": {
    "postcss": {
      "nanoid": "3.3.19"
    }
  },
  "description": "Local headless HTML-to-video renderer for AI agents: shots are plain web pages driven by render(t), with determinism checks, cut-aware motion blur and a 3D layer with accumulated depth of field.",
  "keywords": [
    "video",
    "renderer",
    "html",
    "headless",
    "chromium",
    "playwright",
    "ffmpeg",
    "ai-agent",
    "deterministic",
    "motion-blur",
    "depth-of-field",
    "three.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBEILC/Multiplane.git"
  },
  "homepage": "https://github.com/LBEILC/Multiplane#readme",
  "bugs": {
    "url": "https://github.com/LBEILC/Multiplane/issues"
  }
}
